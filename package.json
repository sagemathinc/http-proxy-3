{
  "name": "http-proxy-3",
  "version": "2.0.0",
  "packageManager": "pnpm@11.9.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sagemathinc/http-proxy-3.git"
  },
  "description": "Modern rewrite of http-proxy",
  "author": "William Stein <wstein@sagemath.com>",
  "contributors": [
    "Charlie Robbins <charlie.robbins@gmail.com>",
    "Jimb Esser (https://github.com/Jimbly/)",
    "jcrugzz <jcrugzz@gmail.com>"
  ],
  "main": "dist/lib/index.js",
  "files": [
    "dist/lib/http-proxy",
    "dist/lib/index.js",
    "dist/lib/index.d.ts"
  ],
  "dependencies": {
    "debug": "^4.4.3",
    "follow-redirects": "^1.16.0"
  },
  "devDependencies": {
    "@types/async": "^3.2.25",
    "@types/body-parser": "^1.19.6",
    "@types/compression": "^1.8.1",
    "@types/concat-stream": "^2.0.3",
    "@types/connect": "^3.4.38",
    "@types/debug": "^4.1.13",
    "@types/express": "^5.0.6",
    "@types/follow-redirects": "^1.14.4",
    "@types/node": "^22.20.1",
    "@types/node-fetch": "^2.6.13",
    "@types/ws": "^8.18.1",
    "async": "^3.2.6",
    "auto-changelog": "^2.6.0",
    "better-sse": "^0.14.1",
    "body-parser": "^2.3.0",
    "compression": "^1.8.1",
    "concat-stream": "^2.0.0",
    "connect": "^3.7.0",
    "eventsource": "^3.0.7",
    "express": "^5.2.1",
    "get-port": "^7.2.0",
    "https-proxy-agent": "^7.0.6",
    "node-fetch": "^2.7.0",
    "semver": "^7.8.5",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "typescript": "^5.9.3",
    "undici": "^7.29.0",
    "vitest": "^4.1.11",
    "ws": "^8.21.3"
  },
  "scripts": {
    "test": "NODE_TLS_REJECT_UNAUTHORIZED=0 vitest run",
    "test-all": "pnpm audit --audit-level=high && TEST_EXTERNAL_REVERSE_PROXY=yes pnpm test --pool threads",
    "test-dual-path": "pnpm test-native && pnpm test-fetch",
    "test-native": "echo '🔧 Testing native HTTP code path...' && NODE_TLS_REJECT_UNAUTHORIZED=0 vitest run",
    "test-fetch": "echo '🚀 Testing fetch code path...' && NODE_TLS_REJECT_UNAUTHORIZED=0 FORCE_FETCH_PATH=true vitest run",
    "test-versions": "bash -c '. \"$NVM_DIR/nvm.sh\" && nvm use 22 && pnpm test && nvm use 24 && pnpm test && nvm use 26 && pnpm test'",
    "clean": "rm -rf dist node_modules",
    "build": "tsc --build",
    "make": "pnpm clean && pnpm install && pnpm build && pnpm test",
    "tsc": "tsc --watch  --pretty --preserveWatchOutput",
    "prepublishOnly": "pnpm test-all && rm -f dist/*.tsbuildinfo dist/.tsconfig-bootstrap* && rm -rf dist/test"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
